/-output "eDP-1" {
    // off

    mode "1920x1080@120.030"

    scale 1
    transform "normal"

    position x=0 y=0
}

output "DP-1" {
    // off

    mode "2560x1440@59.951"

    scale 1
    transform "normal"

    position x=0 y=0
}

output "HDMI-A-1" {
    // off

    mode "2560x1440@99.946"

    scale 1
    transform "normal"

    position x=2560 y=0
}
