# Private GitHub input over SSH; follows main by default. No local clone needed.
MY_NIXOS_PRIVATE=git@github.com/YOUR-USER/my-nixos-private
# Optional branch/tag:
# MY_NIXOS_PRIVATE=git@github.com/YOUR-USER/my-nixos-private?ref=YOUR-REF
# Or use an existing local checkout's committed HEAD:
# MY_NIXOS_PRIVATE=/absolute/path/to/my-nixos-private
# Never put credentials or private keys in this file.
