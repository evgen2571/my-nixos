@@ -942,3 +942,15 @@
         ],
         any_order=True,
     )
+
+
+@patch(get_qualified_name(n.run_wrapper, n), autospec=True)
+def test_deployment_refusal_precedes_profile_selection(mock_run: Mock) -> None:
+    from subprocess import CalledProcessError
+    mock_run.side_effect = CalledProcessError(1, "deployment-preflight")
+    with pytest.raises(CalledProcessError):
+        n.set_profile(m.Profile("system", Path("/test/profile")), Path("/test/system"), None, False)
+    assert mock_run.call_count == 1
+    args = mock_run.call_args.args[0]
+    assert "deployment-preflight" in args[2]
+    assert "nix-env" not in args
