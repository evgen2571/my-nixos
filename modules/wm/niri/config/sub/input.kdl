input {
    focus-follows-mouse
    workspace-auto-back-and-forth
    warp-mouse-to-focus

    keyboard {
        xkb {
            layout "us,ru"
            variant ",phonetic"
            options "grp:alt_shift_toggle,caps:swapescape"
        }

		repeat-delay 250
		repeat-rate 35
    }

    touchpad {
        // off
        tap
        natural-scroll
        scroll-method "two-finger"
		scroll-factor 0.40
    }

    mouse {
        // natural-scroll
		scroll-factor 1.0
        // scroll-method "no-scroll"
    }
}
