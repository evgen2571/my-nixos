  fileSystems."/" = {
    device = "/dev/disk/by-uuid/bad38231-8de2-41aa-a26c-861eba558f80";
    fsType = "ext4";
  };

  fileSystems."/home/${config.my.primaryUser.name}/drive" = {
    device = "/dev/disk/by-uuid/d1038ac0-6fd0-4d1e-b6bf-c1dee40e8bec";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/A8E4-6894";
    fsType = "vfat";
    options = [
      "fmask=0022"
      "dmask=0022"
    ];
  };

  swapDevices = [ ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
