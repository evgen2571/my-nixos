// Zen: keep normal browser windows on the browser workspace.
window-rule {
    match app-id=r#"^(zen-beta|zen)$"#
    exclude title=r#"^(Picture-in-Picture|Picture in picture)$"#
    exclude title=r#"^Delete Space\?$"#
    open-maximized-to-edges true
    open-on-workspace "browser"

	draw-border-with-background false
	background-effect {
		blur true
		xray true
	}
}

// Niri centers new floating windows when no position is specified.
window-rule {
    match app-id=r#"^(zen-beta|zen)$"# title=r#"^Delete Space\?$"#
    open-floating true
    open-maximized-to-edges false
}
