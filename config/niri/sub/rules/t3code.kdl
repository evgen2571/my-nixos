// T3 Code desktop application (PC: second named HDMI-A-1 workspace).
// The Electron app ID can differ between development and packaged builds.
window-rule {
    match app-id=r#"^(com\.t3tools\.(T3Code|t3code)(\.Development)?|t3code|T3Code)$"#
    open-floating false
    open-maximized-to-edges true
    open-on-workspace "code"
}
