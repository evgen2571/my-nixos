workspace "browser" {
	open-on-output "DP-1"
}

workspace "chats" {
	open-on-output "DP-1"
}

workspace "music" {
	open-on-output "DP-1"
}

workspace "anki" {
	open-on-output "DP-1"
}

workspace "notes" {
	open-on-output "HDMI-A-1"
}

workspace "code" {
	open-on-output "HDMI-A-1"

	layout {
		default-column-display "normal"
		default-column-width { proportion 0.5; }
	}
}

workspace "gaming" {
	open-on-output "HDMI-A-1"
}
