	open-on-output "eDP-1"

	layout {
		default-column-display "normal"
		default-column-width { proportion 0.5; }
	}
}

workspace "notes" {
	open-on-output "eDP-1"
}

workspace "chats" {
	open-on-output "eDP-1"
}

workspace "gaming" {
	open-on-output "eDP-1"
}

workspace "anki" {
	open-on-output "eDP-1"
}
