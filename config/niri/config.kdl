// KDL syntax: https://kdl.dev. Use "/-" to disable the following node.
// Niri settings: https://niri-wm.github.io/niri/Configuration%3A-Introduction.html

config-notification {
    disable-failed
}

blur {
    passes 3
    offset 4.0
    noise 0.02
    saturation 1.4
}

gestures {
    hot-corners {
        off
    }
}

overview {
    workspace-shadow {
        off
    }
}

// Identify this session to desktop integrations.
environment {
  XDG_CURRENT_DESKTOP "niri"
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
screenshot-path "~/screenshots/screenshot-from-%Y-%m-%d %H-%M-%S.png"

animations {
    workspace-switch {
        spring damping-ratio=0.80 stiffness=523 epsilon=0.0001
    }

    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.75 stiffness=323 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
}

recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

include "sub/outputs.kdl"
include "sub/workspaces.kdl"
include "sub/rules/common.kdl"
include "sub/binds.kdl"
include "sub/layout.kdl"
include "sub/input.kdl"
include "sub/startup.kdl"

include "./noctalia.kdl"

// Optional before the first render; layout.kdl supplies a neutral fallback.
include optional=true "./noctalia-layout.kdl"

// Noctalia-generated dropdown colors; optional before the first theme render.
include optional=true "./noctalia-dropdown.kdl"
