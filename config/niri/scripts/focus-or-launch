#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo 'Usage: focus-or-launch APP_ID_REGEX [--title TITLE_REGEX] [--close-focused] -- COMMAND [ARGS...]' >&2
    exit 2
}

[[ $# -ge 1 ]] || usage
pattern=$1
shift
title_pattern='.*'
close_focused=false
while [[ ${1:-} != -- ]]; do
    case ${1:-} in
        --title)
            [[ $# -ge 2 ]] || usage
            title_pattern=$2
            shift 2
            ;;
        --close-focused)
            close_focused=true
            shift
            ;;
        *) usage ;;
    esac
done
shift
[[ $# -ge 1 ]] || usage

windows=$(niri msg --json windows)
# Reuse the focused match first, otherwise the most recently focused match.
id=$(jq -r --arg pattern "$pattern" --arg title "$title_pattern" '
    [.[] | select(((.app_id // "") | test($pattern)) and ((.title // "") | test($title)))]
    | sort_by([.is_focused // false, .focus_timestamp.secs // 0, .focus_timestamp.nanos // 0, .id])
    | last | .id // empty
' <<< "$windows")
if [[ -n $id ]]; then
    if [[ $close_focused == true ]] && jq -e --argjson id "$id" '.[] | select(.id == $id and .is_focused)' <<< "$windows" >/dev/null; then
        niri msg action close-window --id "$id"
    else
        niri msg action focus-window --id "$id"
    fi
else
    exec "$@"
fi
