// Generated by Noctalia; applied only to the dropdown terminal.
window-rule {
    match app-id=r#"^kitty$"# title="^dropdown-term$"
    focus-ring {
        on
        width 3
        active-color "{{ colors.primary.default.hex }}"
    }

    shadow {
        on
        spread 4
        softness 10
        color "{{ colors.primary_container.default.hex }}73"
    }
}
